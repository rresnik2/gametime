# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_ values are bundled into the app, so only put public keys here.
#
# Local development: run `npm run db:start`, then copy API_URL and PUBLISHABLE_KEY from
# `npx supabase status`. Hosted project: Project Settings > API keys in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
